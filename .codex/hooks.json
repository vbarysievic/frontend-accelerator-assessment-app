{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/toolchain/hooks/runtime-hook.mjs\" codex SessionStart --registration frontend-accelerator.changed-file-lint-gate.v1",
            "commandWindows": "powershell.exe -NoProfile -Command \"$r=(git rev-parse --show-toplevel).Trim(); & node (Join-Path $r 'toolchain/hooks/runtime-hook.mjs') codex SessionStart --registration frontend-accelerator.changed-file-lint-gate.v1\"",
            "timeout": 15,
            "statusMessage": "Activating frontend accelerator guardrails"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/toolchain/hooks/runtime-hook.mjs\" codex PreToolUse --registration frontend-accelerator.changed-file-lint-gate.v1",
            "commandWindows": "powershell.exe -NoProfile -Command \"$r=(git rev-parse --show-toplevel).Trim(); & node (Join-Path $r 'toolchain/hooks/runtime-hook.mjs') codex PreToolUse --registration frontend-accelerator.changed-file-lint-gate.v1\"",
            "timeout": 15,
            "statusMessage": "Recording pre-change state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/toolchain/hooks/runtime-hook.mjs\" codex PostToolUse --registration frontend-accelerator.changed-file-lint-gate.v1",
            "commandWindows": "powershell.exe -NoProfile -Command \"$r=(git rev-parse --show-toplevel).Trim(); & node (Join-Path $r 'toolchain/hooks/runtime-hook.mjs') codex PostToolUse --registration frontend-accelerator.changed-file-lint-gate.v1\"",
            "timeout": 15,
            "statusMessage": "Recording changed files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/toolchain/hooks/runtime-hook.mjs\" codex Stop --registration frontend-accelerator.changed-file-lint-gate.v1",
            "commandWindows": "powershell.exe -NoProfile -Command \"$r=(git rev-parse --show-toplevel).Trim(); & node (Join-Path $r 'toolchain/hooks/runtime-hook.mjs') codex Stop --registration frontend-accelerator.changed-file-lint-gate.v1\"",
            "timeout": 300,
            "statusMessage": "Linting files changed in this session"
          }
        ]
      }
    ]
  }
}
